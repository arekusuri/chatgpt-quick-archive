{
  "manifest_version": 3,
  "name": "ChatGPT Quick Archive",
  "version": "0.1.2",
  "description": "Adds a one-click archive button to ChatGPT conversation rows.",
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["core.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
